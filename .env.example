# Copy to .env and adjust if needed. All values are optional — these are the defaults.
# No API keys are required: everything runs on a local Ollama server.

OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Context window for the LLM, and how many resumes are evaluated in parallel.
NUM_CTX=8192
MAX_WORKERS=2
